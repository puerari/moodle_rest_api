# Arquivos de desenvolvimento ficam fora do pacote baixado pelo Composer (dist do GitHub/Packagist).
/.github            export-ignore
/tests              export-ignore
/tools              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CLAUDE.md          export-ignore
/CONTRIBUTING.md    export-ignore
/phpcs.xml.dist     export-ignore
/phpunit.xml.dist   export-ignore
/rector.php         export-ignore

# Scripts de shell sempre com LF, mesmo com core.autocrlf=true (com CRLF o sh não os executa).
*.sh    text eol=lf
