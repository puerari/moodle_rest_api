<?xml version="1.0"?>
<ruleset name="moodle_rest_api">
    <description>Compatibilidade do código com PHP 5.6 até a versão mais recente conhecida pelo PHPCompatibility.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg value="ps"/>

    <config name="testVersion" value="5.6-"/>
    <rule ref="PHPCompatibility"/>
</ruleset>
